<?xml version="1.0"?>
<robot name="my_robot" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:arg name="chassis_mesh" default="false"/>
  <link name="chassis">
    <inertial>
      <mass value="1.0"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="0.02083" ixy="0.0" ixz="0.0" iyy="0.07083" iyz="0.0" izz="0.08333"/>
    </inertial>
    
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.4 0.2 0.1"/>
      </geometry>
    </collision>

    <!-- Visual do chassi. A malha do pioneer2dx é um modelo do Gazebo e o RViz não
         resolve package://pioneer2dx (RobotModel dá erro). Por padrão usa-se uma
         caixa com as mesmas dimensões da malha escalada (x +-0.23, z até 0.08).
         Para voltar à malha, mude o default de chassis_mesh para true. -->
    <xacro:if value="$(arg chassis_mesh)">
      <visual>
        <origin xyz="0 0 0.05" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://pioneer2dx/meshes/chassis.dae" scale="0.9 0.5 0.5"/>
        </geometry>
      </visual>
    </xacro:if>
    <xacro:unless value="$(arg chassis_mesh)">
      <visual>
        <origin xyz="0 0 0.01" rpy="0 0 0"/>
        <geometry>
          <box size="0.46 0.16 0.14"/>
        </geometry>
        <material name="chassis_color"><color rgba="0.85 0.45 0.1 1.0"/></material>
      </visual>
    </xacro:unless>

    <collision>
      <origin xyz="-0.15 0 -0.05" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.05"/>
      </geometry>
    </collision>

    <visual>
      <origin xyz="-0.15 0 -0.05" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.05"/>
      </geometry>
    </visual>
  </link>

  <link name="left_wheel">
    <inertial>
      <mass value="0.5"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="0.0027083" ixy="0.0" ixz="0.0" iyy="0.0027083" iyz="0.0" izz="0.005"/>
    </inertial>
    <collision>
      <geometry>
        <cylinder radius="0.1" length="0.05"/>
      </geometry>
    </collision>
    <visual>
      <geometry>
        <cylinder radius="0.1" length="0.05"/>
      </geometry>
    </visual>
  </link>

  <link name="right_wheel">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.5"/>
      <inertia ixx="0.0027083" ixy="0.0" ixz="0.0" iyy="0.0027083" iyz="0.0" izz="0.005"/>
    </inertial>
    <collision>
      <geometry>
        <cylinder radius="0.1" length="0.05"/>
      </geometry>
    </collision>
    <visual>
      <geometry>
        <cylinder radius="0.1" length="0.05"/>
      </geometry>
    </visual>
  </link>

  <joint name="left_wheel_hinge" type="continuous">
    <origin xyz="0.1 0.13 0" rpy="0 1.5707 1.5707"/>
    <parent link="chassis"/>
    <child link="left_wheel"/>
    <axis xyz="0 0 1"/>
    <dynamics damping="0.05" friction="0.02"/>
  </joint>

  <joint name="right_wheel_hinge" type="continuous">
    <origin xyz="0.1 -0.13 0" rpy="0 1.5707 1.5707"/>
    <parent link="chassis"/>
    <child link="right_wheel"/>
    <axis xyz="0 0 1"/>
    <dynamics damping="0.05" friction="0.02"/>
  </joint>
  

  <gazebo reference="left_wheel">
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
  </gazebo>

  <gazebo reference="right_wheel">
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
  </gazebo>
  
  <gazebo reference="chassis">
    <mu1>0.0</mu1>
    <mu2>0.0</mu2>
  </gazebo>

  <gazebo>
    <static>false</static>
  </gazebo>
  
  
  
  
  <!-- Prática 04: sensores (IMU, GPS, câmera, lidar) -->
  <xacro:include filename="$(find robot_control)/urdf/sensors.xacro"/>

  <!-- Prática 04: ground truth do chassi -> /ground_truth/odom (frame world).
       Serve só para AVALIAR o erro real de seguimento; o controle não o usa. -->
  <gazebo>
    <plugin name="ground_truth" filename="libgazebo_ros_p3d.so">
      <ros><namespace>/ground_truth</namespace></ros>
      <body_name>chassis</body_name>
      <frame_name>world</frame_name>
      <update_rate>50.0</update_rate>
      <gaussian_noise>0.0</gaussian_noise>
    </plugin>
  </gazebo>

  <gazebo>
    <plugin filename="libgazebo_ros2_control.so" name="gazebo_ros2_control">
      <parameters>$(find robot_control)/config/my_robot_controllers.yaml</parameters>
    </plugin>
  </gazebo>

  <ros2_control name="GazeboSystem" type="system">
    <hardware>
      <plugin>gazebo_ros2_control/GazeboSystem</plugin>
    </hardware>
    <joint name="left_wheel_hinge">
      <param name="vel_kp">1.0</param>
      <param name="vel_ki">0.5</param>
      <param name="vel_kd">0.0</param>
      <param name="vel_max_integral_error">10</param>

      <command_interface name="velocity_pid"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="right_wheel_hinge">
      <param name="vel_kp">1.0</param>
      <param name="vel_ki">0.5</param>
      <param name="vel_kd">0.0</param>
      <param name="vel_max_integral_error">10</param>

      <command_interface name="velocity_pid"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
  </ros2_control>


</robot>
