<?xml version="1.0"?>
<sdf version="1.6">
  <world name="default">

    <include><uri>model://sun</uri></include>
    <include><uri>model://ground_plane</uri></include>

    <physics type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>

    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <latitude_deg>38.161479</latitude_deg>
      <longitude_deg>-122.454630</longitude_deg>
      <elevation>0.0</elevation>
      <heading_deg>180</heading_deg>
    </spherical_coordinates>

    <!-- caixa vermelha à frente do robô (+X) -->
    <model name="box_red">
      <static>true</static>
      <pose>3.0 0.0 0.25 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.5 0.5 0.5</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.5 0.5 0.5</size></box></geometry>
          <material><ambient>0.8 0.1 0.1 1</ambient><diffuse>0.8 0.1 0.1 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- cilindro verde -->
    <model name="cylinder_green">
      <static>true</static>
      <pose>3.5 -1.5 0.3 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><cylinder><radius>0.25</radius><length>0.6</length></cylinder></geometry></collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.25</radius><length>0.6</length></cylinder></geometry>
          <material><ambient>0.1 0.7 0.2 1</ambient><diffuse>0.1 0.7 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- parede azul ao norte (+Y) -->
    <model name="wall_blue">
      <static>true</static>
      <pose>0.0 3.5 0.3 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>3.0 0.15 0.6</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>3.0 0.15 0.6</size></box></geometry>
          <material><ambient>0.1 0.3 0.9 1</ambient><diffuse>0.1 0.3 0.9 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- cilindro amarelo ao sul-oeste -->
    <model name="cylinder_yellow">
      <static>true</static>
      <pose>-2.5 -2.5 0.3 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><cylinder><radius>0.3</radius><length>0.6</length></cylinder></geometry></collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.3</radius><length>0.6</length></cylinder></geometry>
          <material><ambient>0.9 0.8 0.1 1</ambient><diffuse>0.9 0.8 0.1 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- caixa laranja ao sul -->
    <model name="box_orange">
      <static>true</static>
      <pose>1.0 -3.5 0.2 0 0 0.6</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.6 0.4 0.4</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.6 0.4 0.4</size></box></geometry>
          <material><ambient>0.95 0.5 0.1 1</ambient><diffuse>0.95 0.5 0.1 1</diffuse></material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
