Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: map
    Frame Rate: 30
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 1
      Plane Cell Count: 20
    - Class: rviz_default_plugins/Map
      Name: Mapa (slam_toolbox)
      Enabled: true
      Alpha: 0.7
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /map
    - Class: rviz_default_plugins/RobotModel
      Name: RobotModel
      Enabled: true
      Description Topic:
        Depth: 5
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /robot_description
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Show Names: false
      Show Axes: true
      Marker Scale: 0.4
    - Class: rviz_default_plugins/LaserScan
      Name: Lidar (LaserScan)
      Enabled: true
      Size (m): 0.04
      Style: Flat Squares
      Color Transformer: FlatColor
      Color: 255; 255; 0
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /lidar/scan
    - Class: rviz_default_plugins/Path
      Name: Trajetoria REAL (ground truth)
      Enabled: true
      Color: 40; 220; 40
      Line Style: Lines
      Line Width: 0.03
      Topic:
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /slam_eval/path_gt
    - Class: rviz_default_plugins/Path
      Name: Trajetoria estimada (SLAM)
      Enabled: true
      Color: 40; 120; 255
      Line Style: Lines
      Line Width: 0.03
      Topic:
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /slam_eval/path_slam
    - Class: rviz_default_plugins/Path
      Name: Odometria relativa (sem correcao do SLAM)
      Enabled: true
      Color: 255; 110; 0
      Line Style: Lines
      Line Width: 0.03
      Topic:
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /slam_eval/path_odom
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Scale: 55
      X: 0
      Y: 0
